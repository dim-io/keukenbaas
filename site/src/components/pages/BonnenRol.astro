---
// Lange bonnenrol: een rij DYMO-labels langs een rail die zich vult terwijl je scrolt. Geen volgorde, geen jaartal.
// items: [{ title, text, now? }]. Zonder JS staat alles er gewoon; het script kleurt alleen de rail en de stippen.
const { items = [] } = Astro.props;
---
<div class="rol" data-rol>
  <span class="rol__rail" aria-hidden="true"><i data-rol-fill></i></span>
  <ul class="rol__list" role="list">
    {items.map((it) => (
      <li class:list={['rol__item', { 'rol__item--now': it.now }]} data-rol-item>
        <span class="rol__dot" aria-hidden="true"></span>
        <div class="rol__label">
          <h4>{it.title}</h4>
          <p>{it.text}</p>
        </div>
      </li>
    ))}
  </ul>
</div>
<script>
  document.querySelectorAll<HTMLElement>('[data-rol]').forEach((rol) => {
    const fill = rol.querySelector<HTMLElement>('[data-rol-fill]')!;
    const items = Array.from(rol.querySelectorAll<HTMLElement>('[data-rol-item]'));
    let maxP = 0; // alleen vooruit: hoogste bereikte waarde blijft staan
    const update = () => {
      const r = rol.getBoundingClientRect();
      const mid = window.innerHeight * 0.6;
      maxP = Math.max(maxP, Math.min(1, Math.max(0, (mid - r.top) / r.height)));
      fill.style.setProperty('--p', String(maxP));
      items.forEach((it) => { if (it.getBoundingClientRect().top < mid) it.classList.add('is-reached'); });
    };
    let tick = 0;
    const onScroll = () => { if (!tick) tick = requestAnimationFrame(() => { tick = 0; update(); }); };
    window.addEventListener('scroll', onScroll, { passive: true });
    window.addEventListener('resize', onScroll);
    update();
  });
</script>
<style>
  .rol { position: relative; padding-left: 3rem; }
  .rol__rail { position: absolute; left: 0.85rem; top: 0.5rem; bottom: 0.5rem; width: 6px; background: var(--line); border-radius: 3px; }
  .rol__rail i { display: block; width: 100%; height: 100%; background: var(--orange); border-radius: 3px; transform: scaleY(var(--p, 1)); transform-origin: top; transition: transform 400ms var(--ease-out); }
  .rol__list { list-style: none; padding: 0; margin: 0; display: grid; gap: var(--space-5); }
  .rol__item { position: relative; }
  .rol__dot { position: absolute; left: -2.65rem; top: 1.1rem; width: 1.5rem; height: 1.5rem; background: var(--white); border: 3px solid var(--navy); border-radius: 50%; }
  .rol__dot { transition: background-color 300ms var(--ease-out); }
  .rol__item.is-reached .rol__dot { background: var(--orange); }
  .rol__label {
    background: var(--white); border: 2px solid var(--navy); border-radius: var(--radius-s); box-shadow: var(--shadow);
    padding: var(--space-4) var(--space-5); display: grid; gap: var(--space-1); max-width: 40rem;
    border-left: 0.6rem solid var(--tape);
  }
  .rol__item:nth-child(even) .rol__label { margin-left: var(--space-5); }
  .rol__item--now .rol__label { background: var(--orange-soft); border-left-color: var(--orange); }
  h4 { font-family: var(--font-mono); font-weight: 600; font-size: var(--step-0); color: var(--navy); text-transform: uppercase; letter-spacing: 0.01em; }
  p { font-size: var(--step-0); margin: 0; }
  @media (max-width: 40rem) { .rol { padding-left: 2.4rem; } .rol__dot { left: -2.1rem; } .rol__item:nth-child(even) .rol__label { margin-left: 0; } .rol__label { padding: var(--space-3) var(--space-4); } }
</style>
