---
// Vinkje over het formulier: vier velden worden afgevinkt en er komt een stempel "Gelukt". Eindstaat standaard.
const rows = ['Naam', 'Zaak', 'Plaats', 'E-mailadres'];
---
<figure class="bb receipt-shadow" data-animate style="margin:0" aria-label="Naam, zaak, plaats en e-mailadres zijn afgevinkt. Gelukt.">
  <div class="receipt bb__bon" aria-hidden="true">
    <ul role="list" class="mono">
      {rows.map((r, i) => (
        <li style={`--n:${i}`}><span>{r}</span><svg viewBox="0 0 20 20" focusable="false"><path class="bb__tick" d="M3.5 10.5l4.5 4.5 8.5-10" pathLength="1" fill="none" stroke="#207657" stroke-width="2.8" stroke-linecap="round" stroke-linejoin="round"/></svg></li>
      ))}
    </ul>
    <p class="bb__stamp" style="--n:4">Gelukt</p>
  </div>
</figure>
<style>
  .bb { width: min(100%, 22rem); transform: rotate(1.2deg); }
  .bb__bon { padding: var(--space-5) var(--space-5) calc(var(--space-5) + 8px); position: relative; }
  ul { list-style: none; padding: 0; margin: 0; display: grid; gap: var(--space-3); }
  li { display: flex; justify-content: space-between; align-items: center; font-size: var(--step-0); color: var(--navy); padding-bottom: var(--space-2); border-bottom: 2px dotted var(--line); }
  li svg { width: 1.5rem; height: 1.5rem; }
  .bb__tick { stroke-dasharray: 1; stroke-dashoffset: 0; }
  .bb__stamp { margin: var(--space-5) 0 0; display: inline-block; font-family: var(--font-display); font-weight: 900; font-stretch: 70%; font-size: var(--step-3); color: var(--green-dark); border: 4px solid var(--green-dark); border-radius: var(--radius-s); padding: 0 var(--space-3); transform: rotate(-6deg); text-transform: uppercase; }
  @media (prefers-reduced-motion: no-preference) {
    .bb[data-animate]:not([data-inview]) .bb__tick { stroke-dashoffset: 1; }
    .bb[data-animate]:not([data-inview]) .bb__stamp { opacity: 0; }
    .bb[data-inview] .bb__tick { animation: bb-draw 500ms var(--ease-out) both; animation-delay: calc(var(--n) * 350ms); }
    .bb[data-inview] .bb__stamp { animation: bb-stamp 300ms var(--ease-snap) both; animation-delay: 1500ms; }
  }
  @keyframes bb-draw { from { stroke-dashoffset: 1; } to { stroke-dashoffset: 0; } }
  @keyframes bb-stamp { from { opacity: 0; transform: rotate(-6deg) scale(1.3); } to { opacity: 1; transform: rotate(-6deg) scale(1); } }
</style>
