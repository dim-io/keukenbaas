---
// Tijdlijn die bij scrollen meeloopt: een voortgangslijn vult zich en tijdstippen klikken aan.
// items: [{ time, title, text, icon: 'weer' | 'lijst' | 'label' | 'thermo' | 'mail' | 'maan' }]; per item een slot "item-<index>" met een illustratie.
import SectionHead from './SectionHead.astro';
import FigScroll from './FigScroll.astro';
const { id = 'dag', title, eyebrow, items = [], figMin = '28rem' } = Astro.props;
const icons = {
  weer: '<circle cx="8" cy="9" r="3"/><path d="M8 2.5V4M2.5 9H4M4.2 5.2l1 1M11.8 5.2l-1 1"/><path d="M8 20h10a3.5 3.5 0 0 0 .4-7A5 5 0 0 0 9.2 12 4 4 0 0 0 8 20z"/>',
  lijst: '<rect x="5" y="4" width="14" height="17" rx="2"/><path d="M9 2.5h6V6H9zM8.5 11.5l1.5 1.5 3-3.5M8.5 17.5h7"/>',
  label: '<path d="M2.5 7h15.5l3.5 5-3.5 5H2.5z"/><path d="M7.5 10.5v3M11 10.5v3M14.5 10.5v3"/>',
  thermo: '<path d="M10 14V5a2 2 0 0 1 4 0v9a4 4 0 1 1-4 0z"/><path d="M12 9.5v7"/>',
  mail: '<rect x="3" y="5" width="18" height="14" rx="2"/><path d="M3.5 6.5l8.5 6.5 8.5-6.5"/>',
  maan: '<path d="M20 14.5A8.5 8.5 0 1 1 9.5 4a7 7 0 0 0 10.5 10.5z"/>',
};
const slotted = await Promise.all(items.map((_, i) => (Astro.slots.has(`item-${i}`) ? Astro.slots.render(`item-${i}`) : '')));
---
<section class="tl on-dark" aria-labelledby={`${id}-h`}>
  <div class="container">
    <SectionHead title={title} eyebrow={eyebrow} id={`${id}-h`} />
    <ol class="tl__list" role="list" data-timeline>
      <li class="tl__rail" aria-hidden="true"><span class="tl__fill" data-tl-fill></span></li>
      {items.map((it, i) => (
        <li class="tl__item" data-tl-item data-passed={i === 0 ? '' : undefined}>
          <div class="tl__when">
            <span class="tl__dot" aria-hidden="true"><svg viewBox="0 0 12 12"><path d="M2.5 6.5l2.5 2.5 4.5-5.5" fill="none" stroke="#0a0d22" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg></span>
            <time class="tl__time mono">{it.time}</time>
          </div>
          <div class="tl__body">
            <div class="tl__text">
              <span class="tl__icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="#0a0d22" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" set:html={icons[it.icon]}></svg></span>
              <h3>{it.title}</h3>
              <p>{it.text}</p>
            </div>
            {slotted[i] && <div class="tl__art"><FigScroll min={figMin}><Fragment set:html={slotted[i]} /></FigScroll></div>}
          </div>
        </li>
      ))}
    </ol>
  </div>
</section>
<script>
  document.querySelectorAll('[data-timeline]').forEach((list) => {
    const items = [...list.querySelectorAll('[data-tl-item]')];
    const fill = list.querySelector('[data-tl-fill]');
    list.setAttribute('data-js', '');
    let raf = 0;
    let maxFill = 0; // hoogste bereikte waarde: de lijn loopt alleen vooruit
    let maxActive = 0;
    const update = () => {
      raf = 0;
      const lr = list.getBoundingClientRect();
      const line = window.innerHeight * 0.55;
      const first = items[0].querySelector('.tl__dot').getBoundingClientRect();
      const top = first.top + first.height / 2 - lr.top;
      const h = Math.max(0, Math.min(lr.height, line - lr.top));
      maxFill = Math.max(maxFill, top, h);
      list.style.setProperty('--tl-fill', maxFill + 'px');
      let active = 0;
      items.forEach((it, i) => {
        const d = it.querySelector('.tl__dot').getBoundingClientRect();
        if (d.top + d.height / 2 <= line || i === 0) it.setAttribute('data-passed', '');
        if (it.hasAttribute('data-passed')) active = i;
      });
      maxActive = Math.max(maxActive, active);
      items.forEach((it, i) => it.toggleAttribute('data-active', i === maxActive));
    };
    const req = () => { if (!raf) raf = requestAnimationFrame(update); };
    addEventListener('scroll', req, { passive: true });
    addEventListener('resize', req);
    update();
  });
</script>
<style>
  .tl { background: var(--navy); color: var(--paper); padding-block: var(--space-9); }
  .tl__list { list-style: none; padding: 0; position: relative; display: grid; gap: var(--space-8); --tl-fill: 0px; }
  .tl__rail { position: absolute; left: 0.75rem; top: 0; bottom: 0; width: 4px; background: color-mix(in srgb, var(--paper) 25%, transparent); margin-left: -2px; }
  .tl__fill { position: absolute; left: 0; top: 0; width: 100%; height: var(--tl-fill); background: var(--orange); transition: height 400ms var(--ease-out); }
  .tl__item { display: grid; grid-template-columns: 6.5rem minmax(0, 1fr); gap: var(--space-4); position: relative; }
  .tl__when { display: flex; align-items: flex-start; gap: var(--space-3); }
  .tl__dot {
    flex: none; width: 1.5rem; height: 1.5rem; margin-top: 0.15rem; border-radius: 50%;
    border: 3px solid var(--paper); background: var(--navy); display: grid; place-items: center; position: relative; z-index: 1;
    transition: background-color var(--dur-2), border-color var(--dur-2), transform var(--dur-2) var(--ease-snap);
  }
  .tl__dot svg { width: 0.8rem; height: 0.8rem; opacity: 0; }
  .tl__time { font-size: var(--step-1); font-weight: 600; color: color-mix(in srgb, var(--paper) 55%, transparent); transition: color var(--dur-2); letter-spacing: 0.02em; }
  [data-passed] .tl__dot { background: var(--orange); border-color: var(--orange); transform: scale(1.12); }
  [data-passed] .tl__dot svg { opacity: 1; }
  [data-passed] .tl__time { color: var(--tape); }
  [data-js] .tl__item:not([data-passed]) .tl__body { opacity: 0.55; }
  .tl__body { display: grid; grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr); gap: var(--space-6); align-items: center; transition: opacity var(--dur-3); }
  .tl__text { display: grid; gap: var(--space-3); justify-items: start; }
  .tl__icon { display: grid; place-items: center; width: 2.75rem; height: 2.75rem; background: var(--tape); border-radius: var(--radius-s); transform: rotate(-3deg); }
  .tl__icon svg { width: 1.6rem; height: 1.6rem; }
  .tl :global(h2) { color: var(--paper); }
  .tl h3 { font-size: var(--step-2); color: var(--paper); }
  .tl__art { background: var(--paper); color: var(--ink); border-radius: var(--radius); padding: var(--space-5); box-shadow: 5px 5px 0 var(--orange); min-width: 0; display: flex; justify-content: center; }
  .tl__art > :global(.figscroll) { width: 100%; }
  .tl__art :global(.mr .receipt) { background: var(--white); }
  @media (max-width: 56rem) {
    .tl__item { grid-template-columns: 1fr; gap: var(--space-3); padding-left: 2.5rem; }
    .tl__when { position: static; }
    .tl__dot { position: absolute; left: 0; top: 0.2rem; }
    .tl__rail { left: 0.75rem; }
    .tl__time { font-size: var(--step-1); }
    .tl__body { grid-template-columns: 1fr; gap: var(--space-5); }
    .tl__art { padding: var(--space-3); }
  }
</style>
