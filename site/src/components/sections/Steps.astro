---
// Genummerde stappen als bonnen aan een rail. steps: [{ title, text }]
import Reveal from './Reveal.astro';
import SectionHead from './SectionHead.astro';
const { id = 'stappen', title, eyebrow, steps = [] } = Astro.props;
---
<section class="st" aria-labelledby={`${id}-h`}>
  <div class="container">
    <SectionHead title={title} eyebrow={eyebrow} id={`${id}-h`} />
    <Reveal>
      <ol class="st__rail" role="list">
        {steps.map((s, i) => (
          <li class="st__item" style={`--i:${i};--r:${[-1.4, 1, -0.7, 1.5][i % 4]}deg`}>
            <span class="st__clip" aria-hidden="true"></span>
            <div class="receipt-shadow">
              <div class="receipt st__bon">
                <span class="st__num" aria-hidden="true">{i + 1}</span>
                <h3>{s.title}</h3>
                <p>{s.text}</p>
              </div>
            </div>
          </li>
        ))}
      </ol>
    </Reveal>
  </div>
</section>
<style>
  .st { background: var(--white); padding-block: var(--space-9); }
  .st__rail { list-style: none; padding: 0; display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: var(--space-5); position: relative; padding-top: var(--space-6); }
  /* de rail: een stalen balk waar de bonnen aan hangen */
  .st__rail::before { content: ""; position: absolute; left: -0.5rem; right: -0.5rem; top: 0.9rem; height: 0.6rem; background: var(--navy); border-radius: 3px; }
  .st__item { position: relative; transform: rotate(var(--r)); transform-origin: 50% 0; padding-top: var(--space-5); }
  .st__item:nth-child(even) { margin-top: var(--space-4); }
  .st__clip { position: absolute; left: 50%; top: -0.2rem; width: 1.6rem; height: 2.2rem; margin-left: -0.8rem; background: var(--orange); border: 2px solid var(--navy); border-radius: 3px; z-index: 2; }
  .st__bon { display: grid; gap: var(--space-3); align-content: start; min-height: 15rem; background: var(--paper); }
  .st__num { font-family: var(--font-display); font-weight: 900; font-stretch: 62%; font-size: var(--step-5); line-height: 0.85; color: var(--orange); }
  .st h3 { font-size: var(--step-2); }
  .st__bon p { font-family: var(--font-body); font-size: var(--step-0); }
  @media (max-width: 56rem) { .st__rail { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width: 40rem) {
    .st__rail { grid-template-columns: 1fr; padding-top: 0; padding-left: 2.2rem; gap: var(--space-6); }
    .st__rail::before { left: 0.4rem; right: auto; top: -0.5rem; bottom: -0.5rem; width: 0.6rem; height: auto; }
    .st__item { padding-top: 0; transform: rotate(calc(var(--r) / 2)); transform-origin: 0 50%; }
    .st__item:nth-child(even) { margin-top: 0; }
    .st__clip { left: -2.3rem; top: 1.6rem; margin-left: 0; width: 2.2rem; height: 1.2rem; }
    .st__bon { min-height: 0; }
  }
</style>
