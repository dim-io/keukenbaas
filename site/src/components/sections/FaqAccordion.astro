---
// Veelgestelde vragen met details/summary. single: één open tegelijk (via name-attribuut van details).
// items: [{ q, a, note? }]; note komt als HTML-commentaar in de pagina.
import Reveal from './Reveal.astro';
import SectionHead from './SectionHead.astro';
const { id = 'faq', title, eyebrow, items = [], single = true } = Astro.props;
---
<section class="faq" aria-labelledby={`${id}-h`}>
  <div class="container faq__in">
    <SectionHead title={title} eyebrow={eyebrow} id={`${id}-h`} />
    <Reveal class="faq__list">
      {items.map((it, i) => (
        <details class="faq__item" name={single ? id : undefined} style={`--i:${Math.min(i, 5)}`}>
          <summary><span>{it.q}</span><i class="faq__plus" aria-hidden="true"></i></summary>
          <div class="faq__a">
            <p>{it.a}</p>
            {it.note && <Fragment set:html={`<!-- ${it.note} -->`} />}
          </div>
        </details>
      ))}
    </Reveal>
  </div>
</section>
<script>
  // Fallback voor browsers zonder details[name]: sluit de andere items zelf.
  document.querySelectorAll('.faq__list').forEach((list) => {
    const items = [...list.querySelectorAll('details[name]')];
    items.forEach((d) => d.addEventListener('toggle', () => {
      if (d.open) items.forEach((o) => { if (o !== d) o.open = false; });
    }));
  });
</script>
<style>
  .faq { background: var(--paper); padding-block: var(--space-9); }
  .faq__in { display: grid; grid-template-columns: minmax(0, 0.7fr) minmax(0, 1.3fr); gap: var(--space-7); align-items: start; }
  .faq__in > :global(.sec-head) { position: sticky; top: var(--space-6); margin-bottom: 0; }
  .faq :global(.faq__list) { display: grid; }
  .faq__item { border-top: 2px solid var(--navy); }
  .faq__item:last-child { border-bottom: 2px solid var(--navy); }
  summary {
    list-style: none; cursor: pointer; display: flex; justify-content: space-between; align-items: center; gap: var(--space-4);
    padding: var(--space-5) 0; min-height: 3.5rem;
    font-family: var(--font-display); font-weight: 800; font-stretch: 85%; font-size: var(--step-1); color: var(--navy); line-height: 1.15;
  }
  summary::-webkit-details-marker { display: none; }
  summary:hover span { text-decoration: underline; text-decoration-color: var(--orange); text-decoration-thickness: 2px; text-underline-offset: 4px; }
  .faq__plus { position: relative; flex: none; width: 2.25rem; height: 2.25rem; border: 2px solid var(--navy); border-radius: 50%; background: var(--white); transition: transform var(--dur-3) var(--ease-snap), background-color var(--dur-2); }
  .faq__plus::before, .faq__plus::after { content: ""; position: absolute; left: 50%; top: 50%; width: 14px; height: 2px; background: var(--navy); transform: translate(-50%, -50%); }
  .faq__plus::after { transform: translate(-50%, -50%) rotate(90deg); }
  details[open] .faq__plus { transform: rotate(135deg); background: var(--orange); }
  .faq__a { padding: 0 3.5rem var(--space-5) 0; }
  .faq__a p { max-width: 58ch; }
  .faq__item::details-content { block-size: 0; overflow: hidden; transition: block-size var(--dur-3) var(--ease-out), content-visibility var(--dur-3) allow-discrete; }
  .faq__item[open]::details-content { block-size: auto; }
  @media (max-width: 56rem) {
    .faq__in { grid-template-columns: 1fr; gap: var(--space-5); }
    .faq__in > :global(.sec-head) { position: static; margin-bottom: var(--space-4); }
    .faq__a { padding-right: 0; }
  }
</style>
