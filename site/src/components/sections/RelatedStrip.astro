---
// Twee (of meer) verwijzingen naar andere pijlers. links: [{ href, label, text, go }]; go is het linklabel (bijv. "Naar uren en fooi"). Optionele slot "icon-<index>" voor een mini-illustratie.
import Reveal from './Reveal.astro';
import SectionHead from './SectionHead.astro';
const { id = 'verwant', title, eyebrow, links = [] } = Astro.props;
---
<section class="rs" aria-labelledby={`${id}-h`}>
  <div class="container">
    <SectionHead title={title} eyebrow={eyebrow} id={`${id}-h`} />
    <Reveal>
      <ul class="rs__list" role="list">
        {links.map((l, i) => (
          <li style={`--i:${i}`}>
            <a class="rs__link bare" href={l.href}>
              <span class="rs__icon" aria-hidden="true">
                {Astro.slots.has(`icon-${i}`) ? <slot name={`icon-${i}`} /> : <svg viewBox="0 0 48 28" focusable="false"><path d="M4 14h36M30 5l11 9-11 9" fill="none" stroke="#0a0d22" stroke-width="3.5" stroke-linecap="round" stroke-linejoin="round"/></svg>}
              </span>
              <span class="rs__txt"><b>{l.label}</b><span>{l.text}</span>{l.go && <span class="rs__cta">{l.go}<span aria-hidden="true"> →</span></span>}</span>
              {!l.go && <span class="rs__go" aria-hidden="true">→</span>}
            </a>
          </li>
        ))}
      </ul>
    </Reveal>
  </div>
</section>
<style>
  .rs { background: var(--paper); padding-block: var(--space-8); }
  .rs__list { list-style: none; padding: 0; display: grid; grid-template-columns: repeat(auto-fit, minmax(18rem, 1fr)); gap: var(--space-5); }
  .rs__link { display: grid; grid-template-columns: 5rem minmax(0, 1fr); gap: var(--space-4); align-items: center; padding: var(--space-5); background: var(--white); border: 2px solid var(--navy); border-radius: var(--radius); box-shadow: var(--shadow); color: var(--navy); transition: transform var(--dur-1) var(--ease-snap), box-shadow var(--dur-1) var(--ease-snap), background-color var(--dur-2); }
  .rs__link:hover { transform: translate(2px, 2px); box-shadow: 1px 1px 0 var(--navy); background: var(--tape); }
  .rs__icon { display: grid; place-items: center; width: 5rem; height: 3.5rem; background: var(--orange-soft); border: 2px solid var(--navy); border-radius: var(--radius-s); overflow: hidden; }
  .rs__icon svg { width: 2.5rem; }
  .rs__txt { display: grid; gap: 2px; }
  .rs__txt b { font-family: var(--font-display); font-weight: 800; font-stretch: 85%; font-size: var(--step-1); }
  .rs__txt span { font-size: var(--step--1); color: var(--ink); }
  .rs__txt .rs__cta { font-family: var(--font-display); font-weight: 800; font-stretch: 85%; font-size: var(--step-0); color: var(--navy); margin-top: var(--space-2); }
  .rs__link:has(.rs__go) { grid-template-columns: 5rem minmax(0, 1fr) auto; }
  .rs__go { font-family: var(--font-mono); font-size: var(--step-1); }
  @media (max-width: 40rem) { .rs__link { grid-template-columns: 3.5rem minmax(0, 1fr); padding: var(--space-4); } .rs__icon { width: 3.5rem; } }
</style>
