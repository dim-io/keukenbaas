---
// Klein telefoonscherm voor in een tegel. lines: string[]. Nette afgeronde rand met alleen een speaker-streep, geen notch.
const { name, lines = [], button } = Astro.props;
---
<div class="mp">
  <div class="mp__speaker" aria-hidden="true"></div>
  <p class="mp__hoi">{name}</p>
  {lines.map((l) => <p class="mp__line mono">{l}</p>)}
  {button && <span class="mp__btn">{button}</span>}
</div>
<style>
  .mp { width: min(100%, 15rem); background: var(--white); border: 3px solid var(--navy); border-radius: 1.6rem; box-shadow: var(--shadow); padding: var(--space-3) var(--space-4) var(--space-5); display: grid; gap: var(--space-3); }
  .mp__speaker { width: 22%; height: 0.3rem; background: var(--line); border-radius: 1rem; margin: 0 auto var(--space-2); }
  .mp__hoi { font-family: var(--font-display); font-weight: 900; font-stretch: 70%; font-size: var(--step-3); color: var(--navy); line-height: 1; }
  .mp__line { font-size: var(--step--1); color: var(--navy); padding: var(--space-2) var(--space-3); background: var(--orange-soft); border: 2px solid var(--navy); border-radius: var(--radius-s); }
  .mp__btn { margin-top: var(--space-2); text-align: center; padding: 0.6rem 0.5rem; background: var(--orange); border: 2px solid var(--navy); border-radius: var(--radius); box-shadow: var(--shadow-s); font-family: var(--font-display); font-weight: 800; font-stretch: 85%; font-size: var(--step--1); color: var(--navy); }
</style>
