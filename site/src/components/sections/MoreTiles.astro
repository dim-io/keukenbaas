---
// Tegels "en verder": kleine briefjes met een plusteken in mono. tiles: [{ title, text }]
import Reveal from './Reveal.astro';
import SectionHead from './SectionHead.astro';
const { id = 'verder', title, eyebrow, tiles = [], tone = 'grid' } = Astro.props;
---
<section class:list={['mt', `mt--${tone}`]} aria-labelledby={`${id}-h`}>
  <div class="container">
    <SectionHead title={title} eyebrow={eyebrow} id={`${id}-h`} />
    <Reveal>
      <ul class="mt__grid" role="list">
        {tiles.map((t, i) => (
          <li class="mt__tile" style={`--i:${i};--r:${[-0.8, 0.6, -0.4, 0.9][i % 4]}deg`}>
            <span class="mt__plus mono" aria-hidden="true">+</span>
            <h3>{t.title}</h3>
            <p>{t.text}</p>
          </li>
        ))}
      </ul>
    </Reveal>
  </div>
</section>
<style>
  .mt { padding-block: var(--space-9); }
  .mt--paper { background: var(--paper); }
  .mt--white { background: var(--white); }
  .mt--grid { background-color: var(--paper); background-image: linear-gradient(to right, color-mix(in srgb, var(--line) 70%, transparent) 1px, transparent 1px), linear-gradient(to bottom, color-mix(in srgb, var(--line) 70%, transparent) 1px, transparent 1px); background-size: 24px 24px; }
  .mt__grid { list-style: none; padding: 0; display: grid; grid-template-columns: repeat(auto-fit, minmax(14rem, 1fr)); gap: var(--space-5); }
  .mt__tile { position: relative; background: var(--white); border: 2px solid var(--navy); border-radius: var(--radius-s); box-shadow: var(--shadow); padding: var(--space-5); padding-top: var(--space-6); transform: rotate(var(--r)); display: grid; gap: var(--space-2); align-content: start; }
  .mt__tile::before { content: ""; position: absolute; top: -0.7rem; left: 1rem; width: 3.5rem; height: 1.2rem; background: var(--tape); border: 2px solid var(--navy); transform: rotate(-3deg); }
  .mt__plus { position: absolute; top: 0.5rem; right: 0.9rem; font-weight: 600; font-size: var(--step-1); color: var(--orange-dark); }
  .mt h3 { font-size: var(--step-1); }
  .mt__tile p { font-size: var(--step--1); }
</style>
