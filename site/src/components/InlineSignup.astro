---
// Fase 1: geen backend. Submit navigeert zonder parameters naar /bedankt.
// Het veld heeft bewust geen name-attribuut, zodat het e-mailadres ook zonder JS nooit in de URL komt.
import Button from './Button.astro';
import { href } from '../lib/url.js';
const { id = 'signup', label = 'E-mailadres', placeholder = 'jij@restaurant.nl', button = 'Zet me op de wachtlijst', variant = 'primary' } = Astro.props;
---
<form class="signup" action={href('/bedankt')} method="get" data-signup data-target={href('/bedankt')}>
  <label class="visually-hidden" for={`${id}-email`}>{label}</label>
  <input id={`${id}-email`} type="email" required autocomplete="email" placeholder={placeholder} />
  <Button type="submit" variant={variant}>{button}</Button>
</form>
<script>
  document.querySelectorAll('[data-signup]').forEach((form) => {
    form.addEventListener('submit', (e) => {
      e.preventDefault();
      if (!form.checkValidity()) { form.reportValidity(); return; }
      window.location.assign(form.dataset.target);
    });
  });
</script>
<style>
  .signup { display: flex; gap: var(--space-3); align-items: stretch; max-width: 36rem; }
  input {
    flex: 1;
    min-width: 0;
    min-height: 3rem;
    padding: 0.6rem 0.9rem;
    background: var(--white);
    border: 2px solid var(--navy);
    border-radius: var(--radius);
    box-shadow: inset 2px 2px 0 var(--line);
    font-family: var(--font-mono);
    font-size: var(--step-0);
  }
  input::placeholder { color: var(--muted); }
  @media (max-width: 40rem) {
    .signup { flex-direction: column; }
  }
</style>
