---
/*
 * MailKaart: de mail die een medewerker krijgt als een dienst wordt aangepast. Stijl: zie STIJLREGELS in DymoLabel.astro.
 * Zodra de kaart voor het eerst in beeld komt (data-inview, blijft staan), glijdt hij vloeiend (ease-out) naar zijn plek
 * en vliegt het envelopje eruit. Eén keer; daarna blijft alles liggen. Bij hover of focus gaat de kaart recht.
 * Zonder JS en bij reduced motion is de eindstaat de standaard. De root draagt data-animate; alleen de kinderen bewegen.
 */
---
<figure class="mk" data-animate style="margin:0">
  <div class="mk__card" tabindex="0" aria-label="De mail Medewerker informeren aan Lotte">
    <div class="mk__tape mono">Medewerker informeren</div>
    <dl class="mk__meta mono">
      <div><dt>Aan:</dt><dd>Lotte</dd></div>
      <div><dt>Onderwerp:</dt><dd>Je rooster is gewijzigd</dd></div>
    </dl>
    <p class="mk__body">Hoi Lotte, je dienst van donderdag 12 november is verplaatst naar vrijdag 13 november, 17:00-23:00.</p>
    <svg class="mk__env" viewBox="0 0 20 14" aria-hidden="true" focusable="false"><rect x="1" y="1" width="18" height="12" rx="2" fill="#fffdf8" stroke="#0a0d22" stroke-width="2" stroke-linejoin="round"/><path d="M2 2.5l8 6 8-6" fill="none" stroke="#e06633" stroke-width="2" stroke-linejoin="round" stroke-linecap="round"/></svg>
  </div>
</figure>
<style>
  .mk { width: min(100%, 26rem); container-type: inline-size; }
  .mk__card {
    position: relative; background: var(--white); border: 2px solid var(--navy); border-radius: var(--radius); box-shadow: var(--shadow);
    padding: 0 0 6cqw; transform: rotate(-1.5deg);
    transition: transform 800ms var(--ease-out), opacity 500ms var(--ease-out), box-shadow var(--dur-3) var(--ease-out);
    color: var(--navy); outline-offset: 4px;
  }
  .mk__tape { background: var(--tape); border-bottom: 2px solid var(--navy); border-radius: calc(var(--radius) - 2px) calc(var(--radius) - 2px) 0 0; padding: 3cqw 5cqw; font-weight: 600; font-size: 4.4cqw; }
  .mk__meta { margin: 0; padding: 4cqw 5cqw 0; display: grid; gap: 1.2cqw; font-size: 3.8cqw; }
  .mk__meta div { display: flex; flex-wrap: wrap; gap: 0 2cqw; }
  .mk__meta dt { color: var(--muted); }
  .mk__meta dd { margin: 0; font-weight: 600; }
  .mk__body { margin: 4cqw 5cqw 0; padding-top: 4cqw; border-top: 2px dotted var(--line); font-size: 4.4cqw; line-height: 1.4; }
  .mk__env { position: absolute; right: 4cqw; bottom: -4cqw; width: 11cqw; height: auto; transform: rotate(8deg); filter: drop-shadow(2px 2px 0 var(--navy)); transition: transform 900ms var(--ease-out) 350ms, opacity 400ms var(--ease-out) 350ms; }
  .mk:hover .mk__card, .mk__card:focus-visible { transform: rotate(0deg); box-shadow: var(--shadow-l); }
  .mk:hover .mk__env, .mk__card:focus-visible .mk__env { animation: mk-wiggle 700ms var(--ease-out); }
  /* Startstaat alleen met JS en zonder reduced motion; data-inview komt één keer en blijft */
  @media (scripting: enabled) and (prefers-reduced-motion: no-preference) {
    .mk:not([data-inview]) .mk__card { opacity: 0; transform: translateY(-12%) rotate(3deg); }
    .mk:not([data-inview]) .mk__env { opacity: 0; transform: translate(-60cqw, -30cqw) rotate(-20deg) scale(0.6); }
  }
  @keyframes mk-wiggle { 0%, 100% { transform: rotate(8deg); } 30% { transform: rotate(-4deg) translateY(-6%); } 70% { transform: rotate(12deg); } }
  .mono { font-family: var(--font-mono); font-variant-numeric: tabular-nums; }
</style>
